# Solo el servidor Next.js utiliza esta dirección. No agregar JWT_KEY aquí.
API_BASE_URL=http://localhost:5169

# Configuración del servidor para Primeros pasos. No usar NEXT_PUBLIC_.
# ZIP preparado con scripts/publish-agent.ps1; requiere el .zip.sha256 contiguo.
# Ruta relativa a src/SecurityCenterAI.Web, o ruta absoluta en el servidor.
AGENT_PACKAGE_PATH=../../artifacts/agent/SecurityCenterAI.Agent-0.4.1-preview.1-win-x64.zip
# Dirección accesible DESDE la PC del agente. HTTPS fuera de loopback.
# No se deduce de API_BASE_URL, que puede ser una dirección interna del servidor.
AGENT_API_URL=http://localhost:5169
